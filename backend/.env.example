# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
# IAM credentials (leave blank to use instance role / ECS task role / env chain)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── Amazon Bedrock Knowledge Base ─────────────────────────────────────────────
KB_ID=your-knowledge-base-id
KB_DATA_SOURCE_ID=your-data-source-id

# ── S3 buckets ────────────────────────────────────────────────────────────────
S3_BUCKET=your-kb-data-source-bucket       # enriched markdown documents
S3_IMAGES_BUCKET=your-images-bucket        # extracted images (must be public-read)
S3_DOC_PREFIX=gd-depth                     # key prefix inside S3_BUCKET

# ── Amazon Bedrock models ─────────────────────────────────────────────────────
BEDROCK_TEXT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@example.com
SESSION_SECRET=change-me-in-production
COOKIE_NAME=gd_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=./users.db

# ── SMTP (optional) ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3001

# ── MCP (optional) ────────────────────────────────────────────────────────────
# MCP_SECRET=your-secret-here
